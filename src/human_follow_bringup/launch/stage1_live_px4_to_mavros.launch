<launch>
  <arg name="image_topic" default="/camera/usb_cam/image_raw" />
  <arg name="require_image_heartbeat" default="true" />
  <arg name="image_rotation_deg" default="0" />
  <arg name="flip_horizontal" default="false" />
  <arg name="flip_vertical" default="false" />
  <arg name="enable_mock_projection" default="true" />
  <arg name="min_consecutive_valid_inputs" default="3" />
  <arg name="bridge_output_topic" default="/follow/offboard/setpoint" />
  <arg name="mavros_setpoint_topic" default="/mavros/setpoint_raw/local" />
  <arg name="set_mode_service" default="/mavros/set_mode" />
  <arg name="controller_provider" default="baseline" />
  <arg name="controller_node_name" default="human_follow_controller" />
  <arg name="external_controller_pkg" default="human_follow_control" />
  <arg name="external_controller_type" default="control_algorithm_template_node.py" />

  <include file="$(find human_follow_bringup)/launch/stage1_live_core.launch">
    <arg name="image_topic" value="$(arg image_topic)" />
    <arg name="require_image_heartbeat" value="$(arg require_image_heartbeat)" />
    <arg name="image_rotation_deg" value="$(arg image_rotation_deg)" />
    <arg name="flip_horizontal" value="$(arg flip_horizontal)" />
    <arg name="flip_vertical" value="$(arg flip_vertical)" />
    <arg name="enable_mock_projection" value="$(arg enable_mock_projection)" />
    <arg name="min_consecutive_valid_inputs" value="$(arg min_consecutive_valid_inputs)" />
    <arg name="controller_provider" value="$(arg controller_provider)" />
    <arg name="controller_node_name" value="$(arg controller_node_name)" />
    <arg name="external_controller_pkg" value="$(arg external_controller_pkg)" />
    <arg name="external_controller_type" value="$(arg external_controller_type)" />
  </include>

  <rosparam command="load" file="$(find human_follow_px4_bridge)/config/px4_bridge.yaml" />
  <rosparam command="load" file="$(find human_follow_px4_bridge)/config/offboard_gate.yaml" />
  <node pkg="human_follow_px4_bridge" type="follow_px4_bridge_node.py" name="human_follow_px4_bridge" output="screen">
    <param name="output_topic" value="$(arg bridge_output_topic)" />
  </node>
  <node pkg="human_follow_px4_bridge" type="offboard_mode_gate_node.py" name="human_follow_offboard_gate" output="screen">
    <param name="input_setpoint_topic" value="$(arg bridge_output_topic)" />
    <param name="output_setpoint_topic" value="$(arg mavros_setpoint_topic)" />
    <param name="set_mode_service" value="$(arg set_mode_service)" />
  </node>
</launch>
