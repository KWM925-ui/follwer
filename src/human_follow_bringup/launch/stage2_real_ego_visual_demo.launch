<launch>
  <arg name="rviz" default="true" />
  <arg name="enable_image_debug" default="false" />
  <arg name="open_image_view" default="false" />
  <arg name="truth_source_mode" default="keyboard" />
  <arg name="truth_motion_mode" default="scripted_standard" />
  <arg name="stage2_target_world_topic" default="/follow/fusion/target_world" />
  <arg name="manual_hidden_affects_tracking" default="false" />
  <arg name="scene_static_obstacle_layout" default="" />
  <arg name="scene_static_obstacle_point_spacing_m" default="0.18" />
  <arg name="scene_static_obstacle_max_depth_m" default="20.0" />
  <arg name="scene_obstacle_pointcloud_topic" default="/follow/lidar/obstacle_points" />
  <arg name="demo_scene_target_bbox_padding" default="1.28" />
  <arg name="demo_scene_min_projected_points" default="2" />
  <arg name="ego_goal_topic" default="/follow/stage2/ego_goal" />
  <arg name="ego_map_size_x" default="80.0" />
  <arg name="ego_map_size_y" default="80.0" />
  <arg name="ego_map_size_z" default="3.0" />
  <arg name="ego_obstacles_inflation" default="0.099" />
  <arg name="ego_cloud_input_topic" default="/follow/lidar/points" />
  <arg name="ego_cloud_extrinsics_yaml" default="$(find human_follow_fusion)/config/camera_mid360_extrinsics.example.yaml" />
  <arg name="ego_cloud_body_yaml" default="$(find human_follow_fusion)/config/camera_to_body_stage1_sim.yaml" />
  <arg name="fusion_pointcloud_timeout_sec" default="0.55" />
  <arg name="fusion_min_support_points" default="4" />
  <arg name="fusion_depth_band_m" default="1.35" />
  <arg name="stage2_follow_distance_m" default="3.5" />
  <arg name="stage2_goal_min_shift_m" default="0.04" />
  <arg name="keyboard_initial_x_m" default="9.0" />
  <arg name="keyboard_initial_y_m" default="0.0" />
  <arg name="keyboard_initial_z_m" default="-1.6" />
  <arg name="demo_tracker_live_timeout_sec" default="0.25" />
  <arg name="demo_tracker_hold_timeout_sec" default="1.20" />
  <arg name="demo_goal_target_timeout_sec" default="0.85" />
  <arg name="demo_require_initial_occupancy_before_planning" default="false" />
  <arg name="enable_face_target_yaw_override" default="true" />
  <arg name="face_target_output_topic" default="/follow/stage2/ego_position_cmd_face_target" />
  <arg name="vehicle_input_topic" default="/follow/stage2/ego_position_cmd_face_target" />
  <arg name="vehicle_position_kp_xy" default="1.60" />
  <arg name="vehicle_position_kp_z" default="1.10" />
  <arg name="vehicle_velocity_tau_sec" default="0.12" />
  <arg name="vehicle_yaw_rate_tau_sec" default="0.08" />
  <arg name="vehicle_max_world_speed_mps" default="1.40" />
  <arg name="vehicle_max_vertical_mps" default="0.70" />

  <include file="$(find human_follow_bringup)/launch/stage1_truth_fusion_controller_regression.launch">
    <arg name="loop" value="true" />
    <arg name="truth_source_mode" value="$(arg truth_source_mode)" />
    <arg name="motion_mode" value="$(arg truth_motion_mode)" />
    <arg name="rviz" value="false" />
    <arg name="enable_monitor" value="false" />
    <arg name="enable_stage1_controller_chain" value="false" />
    <arg name="enable_stage1_px4_bridge" value="false" />
    <arg name="enable_image_debug" value="$(arg enable_image_debug)" />
    <arg name="open_image_view" value="$(arg open_image_view)" />
    <arg name="phase_visible_affects_tracking" value="$(arg manual_hidden_affects_tracking)" />
    <arg name="keyboard_display_visibility_controls_tracking" value="$(arg manual_hidden_affects_tracking)" />
    <arg name="vehicle_input_topic" value="$(arg vehicle_input_topic)" />
    <arg name="vehicle_input_mode" value="position_command" />
    <arg name="vehicle_position_kp_xy" value="$(arg vehicle_position_kp_xy)" />
    <arg name="vehicle_position_kp_z" value="$(arg vehicle_position_kp_z)" />
    <arg name="vehicle_yaw_kp" value="2.40" />
    <arg name="vehicle_max_yaw_rate_rps" value="1.80" />
    <arg name="vehicle_max_world_speed_mps" value="$(arg vehicle_max_world_speed_mps)" />
    <arg name="vehicle_max_vertical_mps" value="$(arg vehicle_max_vertical_mps)" />
    <arg name="vehicle_initial_x_m" value="0.0" />
    <arg name="vehicle_initial_y_m" value="0.0" />
    <arg name="vehicle_initial_z_m" value="1.2" />
    <arg name="vehicle_initial_yaw_deg" value="0.0" />
    <arg name="vehicle_velocity_tau_sec" value="$(arg vehicle_velocity_tau_sec)" />
    <arg name="vehicle_yaw_rate_tau_sec" value="$(arg vehicle_yaw_rate_tau_sec)" />
    <arg name="keyboard_initial_x_m" value="$(arg keyboard_initial_x_m)" />
    <arg name="keyboard_initial_y_m" value="$(arg keyboard_initial_y_m)" />
    <arg name="keyboard_initial_z_m" value="$(arg keyboard_initial_z_m)" />
    <arg name="keyboard_publish_default_target_on_startup" value="false" />
    <arg name="keyboard_clamp_goal_to_visible_envelope" value="false" />
    <arg name="keyboard_goal_min_forward_m" value="0.4" />
    <arg name="keyboard_goal_max_forward_m" value="12.0" />
    <arg name="keyboard_goal_max_lateral_abs_m" value="4.0" />
    <arg name="scene_static_obstacle_layout" value="$(arg scene_static_obstacle_layout)" />
    <arg name="scene_static_obstacle_point_spacing_m" value="$(arg scene_static_obstacle_point_spacing_m)" />
    <arg name="scene_static_obstacle_max_depth_m" value="$(arg scene_static_obstacle_max_depth_m)" />
    <arg name="scene_foreground_pointcloud_topic" value="/follow/lidar/foreground_points" />
    <arg name="scene_obstacle_pointcloud_topic" value="$(arg scene_obstacle_pointcloud_topic)" />
    <arg name="scene_target_bbox_padding" value="$(arg demo_scene_target_bbox_padding)" />
    <arg name="scene_min_projected_points" value="$(arg demo_scene_min_projected_points)" />
    <arg name="fusion_pointcloud_timeout_sec" value="$(arg fusion_pointcloud_timeout_sec)" />
    <arg name="fusion_min_support_points" value="$(arg fusion_min_support_points)" />
    <arg name="fusion_depth_band_m" value="$(arg fusion_depth_band_m)" />
    <arg name="tracker_live_timeout_sec" value="$(arg demo_tracker_live_timeout_sec)" />
    <arg name="tracker_hold_timeout_sec" value="$(arg demo_tracker_hold_timeout_sec)" />
    <arg name="visualizer_stage2_ego_cmd_topic" value="$(arg vehicle_input_topic)" />
  </include>

  <node pkg="tf2_ros" type="static_transform_publisher" name="map_to_world_static_tf" args="0 0 0 0 0 0 map world" />

  <node pkg="human_follow_bringup" type="stage2_bspline_path_visualizer_node.py" name="stage2_bspline_path_visualizer" output="screen">
    <param name="input_topic" value="/planning/bspline" />
    <param name="path_topic" value="/follow/stage2/ego_bspline_path" />
    <param name="frame_id" value="map" />
    <param name="sample_dt_sec" value="0.05" />
  </node>

  <include file="$(find human_follow_bringup)/launch/stage2_real_ego.launch">
    <arg name="stage2_enabled" value="true" />
    <arg name="odom_topic" value="/follow/sim/vehicle_odom" />
    <arg name="target_world_topic" value="$(arg stage2_target_world_topic)" />
    <arg name="ego_goal_topic" value="$(arg ego_goal_topic)" />
    <arg name="ego_map_size_x" value="$(arg ego_map_size_x)" />
    <arg name="ego_map_size_y" value="$(arg ego_map_size_y)" />
    <arg name="ego_map_size_z" value="$(arg ego_map_size_z)" />
    <arg name="ego_obstacles_inflation" value="$(arg ego_obstacles_inflation)" />
    <arg name="ego_cloud_input_topic" value="$(arg ego_cloud_input_topic)" />
    <arg name="ego_cloud_to_world_enabled" value="true" />
    <arg name="ego_cloud_extrinsics_yaml" value="$(arg ego_cloud_extrinsics_yaml)" />
    <arg name="ego_cloud_body_yaml" value="$(arg ego_cloud_body_yaml)" />
    <arg name="ego_world_frame_id" value="map" />
    <arg name="follow_distance_m" value="$(arg stage2_follow_distance_m)" />
    <arg name="goal_min_shift_m" value="$(arg stage2_goal_min_shift_m)" />
    <arg name="goal_target_timeout_sec" value="$(arg demo_goal_target_timeout_sec)" />
    <arg name="goal_search_timeout_sec" value="0.6" />
    <arg name="goal_lost_timeout_sec" value="5.0" />
    <arg name="goal_search_yaw_rate_rps" value="0.20" />
    <arg name="goal_search_sweep_span_deg" value="70.0" />
    <arg name="goal_search_sweep_pass_count" value="1" />
    <arg name="goal_search_return_to_center" value="true" />
    <arg name="goal_search_radius_m" value="0.8" />
    <arg name="goal_require_initial_occupancy_before_planning" value="$(arg demo_require_initial_occupancy_before_planning)" />
  </include>

  <group if="$(arg enable_face_target_yaw_override)">
    <node pkg="human_follow_bringup" type="stage2_face_target_yaw_override_node.py" name="stage2_face_target_yaw_override" output="screen">
      <param name="input_topic" value="/follow/stage2/ego_position_cmd" />
      <param name="output_topic" value="$(arg face_target_output_topic)" />
      <param name="target_world_topic" value="$(arg stage2_target_world_topic)" />
      <param name="odom_topic" value="/follow/sim/vehicle_odom" />
      <param name="target_timeout_sec" value="0.8" />
      <param name="odom_timeout_sec" value="0.8" />
      <param name="min_face_distance_m" value="0.15" />
    </node>
  </group>

  <group if="$(arg rviz)">
    <node pkg="rviz" type="rviz" name="stage2_real_ego_visual_demo_rviz" args="-d $(find human_follow_bringup)/rviz/stage2_real_ego_integrated.rviz" />
  </group>

  <group if="$(arg open_image_view)">
    <node pkg="image_view" type="image_view" name="stage2_visual_demo_overlay_image_view" args="image:=/follow/debug/overlay_image" />
  </group>
</launch>
