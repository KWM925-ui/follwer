<launch>
  <arg name="bridge_output_topic" default="/mavros/setpoint_raw/local" />
  <arg name="publish_external_odom" default="true" />
  <arg name="external_odom_topic" default="/mavros/odometry/out" />

  <include file="$(find human_follow_bringup)/launch/stage1_tracker_sequence.launch" />

  <group if="$(arg publish_external_odom)">
    <include file="$(find human_follow_bringup)/launch/stage1_external_odom_emulator.launch">
      <arg name="output_topic" value="$(arg external_odom_topic)" />
    </include>
  </group>

  <rosparam command="load" file="$(find human_follow_px4_bridge)/config/px4_bridge.yaml" />
  <node pkg="human_follow_px4_bridge" type="follow_px4_bridge_node.py" name="human_follow_px4_bridge" output="screen">
    <param name="output_topic" value="$(arg bridge_output_topic)" />
  </node>
</launch>
