<launch>
  <arg name="stage2_enabled" default="false" />
  <arg name="goal_provider" default="baseline" />
  <arg name="goal_node_name" default="stage2_follow_goal_generator" />
  <arg name="external_goal_pkg" default="human_follow_bringup" />
  <arg name="external_goal_type" default="stage2_follow_goal_generator_node.py" />
  <arg name="goal_topic" default="/follow/stage2/goal" />
  <arg name="debug_goal_path_topic" default="/follow/stage2/debug_goal_path" />
  <arg name="goal_world_frame_id" default="map" />
  <arg name="goal_rate_hz" default="15.0" />
  <arg name="goal_target_timeout_sec" default="0.35" />
  <arg name="goal_odom_timeout_sec" default="0.6" />
  <arg name="follow_distance_m" default="3.5" />
  <arg name="goal_lateral_bias_m" default="0.0" />
  <arg name="goal_vertical_bias_m" default="0.0" />
  <arg name="goal_min_shift_m" default="0.08" />
  <arg name="goal_face_target_yaw" default="true" />
  <arg name="goal_search_timeout_sec" default="2.0" />
  <arg name="goal_lost_timeout_sec" default="5.0" />
  <arg name="goal_search_yaw_rate_rps" default="0.25" />
  <arg name="goal_search_sweep_span_deg" default="0.0" />
  <arg name="goal_search_sweep_pass_count" default="0" />
  <arg name="goal_search_return_to_center" default="false" />
  <arg name="goal_search_radius_m" default="1.0" />
  <arg name="goal_require_initial_occupancy_before_planning" default="false" />
  <arg name="planner_command_topic" default="/follow/stage2/ego_position_cmd" />
  <arg name="bridge_output_topic" default="/follow/stage2/offboard/setpoint" />
  <arg name="mavros_setpoint_topic" default="/mavros/setpoint_raw/local" />
  <arg name="set_mode_service" default="/mavros/set_mode" />
  <arg name="odom_topic" default="/follow/lio/odom" />
  <arg name="target_world_topic" default="/follow/fusion/target_world" />
  <arg name="enable_ego_topic_adapter" default="true" />
  <arg name="ego_goal_topic" default="/move_base_simple/goal" />
  <arg name="ego_waypoint_topic" default="/waypoint_generator/waypoints" />
  <arg name="ego_odom_topic" default="/odom_world" />
  <arg name="ego_grid_odom_topic" default="/grid_map/odom" />
  <arg name="ego_cloud_topic" default="/grid_map/cloud" />
  <arg name="ego_cloud_input_topic" default="/follow/lidar/points" />
  <arg name="ego_cloud_to_world_enabled" default="false" />
  <arg name="ego_cloud_extrinsics_yaml" default="" />
  <arg name="ego_cloud_body_yaml" default="" />
  <arg name="ego_world_frame_id" default="map" />

  <arg name="ego_map_size_x" default="40.0" />
  <arg name="ego_map_size_y" default="40.0" />
  <arg name="ego_map_size_z" default="3.0" />
  <arg name="ego_max_vel" default="1.0" />
  <arg name="ego_max_acc" default="1.5" />
  <arg name="ego_planning_horizon" default="6.0" />
  <arg name="ego_time_forward" default="0.5" />
  <arg name="ego_obstacles_inflation" default="0.099" />

  <include file="$(find human_follow_bringup)/launch/stage2_placeholder.launch">
    <arg name="stage2_enabled" value="$(arg stage2_enabled)" />
    <arg name="goal_provider" value="$(arg goal_provider)" />
    <arg name="goal_node_name" value="$(arg goal_node_name)" />
    <arg name="external_goal_pkg" value="$(arg external_goal_pkg)" />
    <arg name="external_goal_type" value="$(arg external_goal_type)" />
    <arg name="target_world_topic" value="$(arg target_world_topic)" />
    <arg name="odom_topic" value="$(arg odom_topic)" />
    <arg name="goal_topic" value="$(arg goal_topic)" />
    <arg name="debug_goal_path_topic" value="$(arg debug_goal_path_topic)" />
    <arg name="goal_world_frame_id" value="$(arg goal_world_frame_id)" />
    <arg name="goal_rate_hz" value="$(arg goal_rate_hz)" />
    <arg name="goal_target_timeout_sec" value="$(arg goal_target_timeout_sec)" />
    <arg name="goal_odom_timeout_sec" value="$(arg goal_odom_timeout_sec)" />
    <arg name="follow_distance_m" value="$(arg follow_distance_m)" />
    <arg name="goal_lateral_bias_m" value="$(arg goal_lateral_bias_m)" />
    <arg name="goal_vertical_bias_m" value="$(arg goal_vertical_bias_m)" />
    <arg name="goal_min_shift_m" value="$(arg goal_min_shift_m)" />
    <arg name="goal_face_target_yaw" value="$(arg goal_face_target_yaw)" />
    <arg name="goal_search_timeout_sec" value="$(arg goal_search_timeout_sec)" />
    <arg name="goal_lost_timeout_sec" value="$(arg goal_lost_timeout_sec)" />
    <arg name="goal_search_yaw_rate_rps" value="$(arg goal_search_yaw_rate_rps)" />
    <arg name="goal_search_sweep_span_deg" value="$(arg goal_search_sweep_span_deg)" />
    <arg name="goal_search_sweep_pass_count" value="$(arg goal_search_sweep_pass_count)" />
    <arg name="goal_search_return_to_center" value="$(arg goal_search_return_to_center)" />
    <arg name="goal_search_radius_m" value="$(arg goal_search_radius_m)" />
    <arg name="goal_require_initial_occupancy_before_planning" value="$(arg goal_require_initial_occupancy_before_planning)" />
    <arg name="planner_command_topic" value="$(arg planner_command_topic)" />
    <arg name="bridge_output_topic" value="$(arg bridge_output_topic)" />
    <arg name="mavros_setpoint_topic" value="$(arg mavros_setpoint_topic)" />
    <arg name="set_mode_service" value="$(arg set_mode_service)" />
    <arg name="enable_ego_topic_adapter" value="$(arg enable_ego_topic_adapter)" />
    <arg name="ego_goal_topic" value="$(arg ego_goal_topic)" />
    <arg name="ego_odom_topic" value="$(arg ego_odom_topic)" />
    <arg name="ego_grid_odom_topic" value="$(arg ego_grid_odom_topic)" />
    <arg name="ego_cloud_topic" value="$(arg ego_cloud_topic)" />
    <arg name="ego_cloud_input_topic" value="$(arg ego_cloud_input_topic)" />
    <arg name="ego_cloud_to_world_enabled" value="$(arg ego_cloud_to_world_enabled)" />
    <arg name="ego_cloud_extrinsics_yaml" value="$(arg ego_cloud_extrinsics_yaml)" />
    <arg name="ego_cloud_body_yaml" value="$(arg ego_cloud_body_yaml)" />
    <arg name="ego_world_frame_id" value="$(arg ego_world_frame_id)" />
  </include>

  <group if="$(arg stage2_enabled)">
    <node pkg="human_follow_bringup" type="stage2_move_base_goal_to_waypoint_path_node.py" name="stage2_move_base_goal_to_waypoint_path" output="screen">
      <param name="input_topic" value="$(arg ego_goal_topic)" />
      <param name="output_topic" value="$(arg ego_waypoint_topic)" />
      <param name="output_frame_id" value="$(arg goal_world_frame_id)" />
    </node>

    <include file="$(find ego_planner)/launch/advanced_param.xml">
      <arg name="map_size_x_" value="$(arg ego_map_size_x)" />
      <arg name="map_size_y_" value="$(arg ego_map_size_y)" />
      <arg name="map_size_z_" value="$(arg ego_map_size_z)" />
      <arg name="odometry_topic" value="$(arg ego_odom_topic)" />
      <arg name="camera_pose_topic" value="/follow/stage2/unused_camera_pose" />
      <arg name="depth_topic" value="/follow/stage2/unused_depth" />
      <arg name="cloud_topic" value="$(arg ego_cloud_topic)" />
      <arg name="cx" value="320.0" />
      <arg name="cy" value="240.0" />
      <arg name="fx" value="387.0" />
      <arg name="fy" value="387.0" />
      <arg name="max_vel" value="$(arg ego_max_vel)" />
      <arg name="max_acc" value="$(arg ego_max_acc)" />
      <arg name="planning_horizon" value="$(arg ego_planning_horizon)" />
      <arg name="obstacles_inflation" value="$(arg ego_obstacles_inflation)" />
      <arg name="flight_type" value="1" />
      <arg name="point_num" value="1" />
      <arg name="point0_x" value="0.0" />
      <arg name="point0_y" value="0.0" />
      <arg name="point0_z" value="1.0" />
      <arg name="point1_x" value="0.0" />
      <arg name="point1_y" value="0.0" />
      <arg name="point1_z" value="1.0" />
      <arg name="point2_x" value="0.0" />
      <arg name="point2_y" value="0.0" />
      <arg name="point2_z" value="1.0" />
      <arg name="point3_x" value="0.0" />
      <arg name="point3_y" value="0.0" />
      <arg name="point3_z" value="1.0" />
      <arg name="point4_x" value="0.0" />
      <arg name="point4_y" value="0.0" />
      <arg name="point4_z" value="1.0" />
    </include>

    <node pkg="ego_planner" name="traj_server" type="traj_server" output="screen">
      <remap from="/position_cmd" to="$(arg planner_command_topic)" />
      <param name="traj_server/time_forward" value="$(arg ego_time_forward)" type="double" />
    </node>
  </group>
</launch>
