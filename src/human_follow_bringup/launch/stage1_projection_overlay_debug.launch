<launch>
  <arg name="image_topic" default="/camera/usb_cam/image_raw" />
  <arg name="pointcloud_topic" default="/laserMapping/cloud_registered_body" />
  <arg name="intrinsics_yaml" default="$(find human_follow_fusion)/config/camera_intrinsics.example.yaml" />
  <arg name="extrinsics_yaml" default="$(find human_follow_fusion)/config/camera_mid360_extrinsics.example.yaml" />
  <arg name="output_topic" default="/follow/debug/projection_overlay_image" />
  <arg name="snapshot_path" default="" />
  <arg name="publish_rate_hz" default="5.0" />
  <arg name="max_points_to_process" default="5000" />

  <node pkg="human_follow_fusion" type="projection_overlay_debug_node.py" name="projection_overlay_debug" output="screen">
    <param name="image_topic" value="$(arg image_topic)" />
    <param name="pointcloud_topic" value="$(arg pointcloud_topic)" />
    <param name="intrinsics_yaml" value="$(arg intrinsics_yaml)" />
    <param name="extrinsics_yaml" value="$(arg extrinsics_yaml)" />
    <param name="output_topic" value="$(arg output_topic)" />
    <param name="snapshot_path" value="$(arg snapshot_path)" />
    <param name="publish_rate_hz" value="$(arg publish_rate_hz)" />
    <param name="max_points_to_process" value="$(arg max_points_to_process)" />
  </node>
</launch>
