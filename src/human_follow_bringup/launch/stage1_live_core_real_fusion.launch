<launch>
  <arg name="image_topic" default="/camera/usb_cam/image_raw" />
  <arg name="require_image_heartbeat" default="true" />
  <arg name="image_rotation_deg" default="180" />
  <arg name="flip_horizontal" default="false" />
  <arg name="flip_vertical" default="false" />
  <arg name="min_consecutive_valid_inputs" default="3" />
  <arg name="pointcloud_topic" default="/laserMapping/cloud_registered_body" />
  <arg name="intrinsics_yaml" default="" />
  <arg name="extrinsics_yaml" default="" />
  <arg name="camera_body_yaml" default="" />
  <arg name="fusion_output_topic" default="/follow/fusion/target_camera" />
  <arg name="fusion_body_output_topic" default="/follow/fusion/target_body" />
  <arg name="fusion_world_output_topic" default="/follow/fusion/target_world" />
  <arg name="controller_provider" default="baseline" />
  <arg name="controller_node_name" default="human_follow_controller" />
  <arg name="external_controller_pkg" default="human_follow_control" />
  <arg name="external_controller_type" default="control_algorithm_template_node.py" />

  <rosparam command="load" file="$(find human_follow_perception)/config/perception.yaml" />
  <rosparam command="load" file="$(find human_follow_fusion)/config/fusion.yaml" />
  <rosparam command="load" file="$(find human_follow_control)/config/control.yaml" />

  <node pkg="human_follow_perception" type="detector_node.py" name="human_follow_detector" output="screen">
    <param name="image_topic" value="$(arg image_topic)" />
    <param name="require_image_heartbeat" value="$(arg require_image_heartbeat)" />
    <param name="image_rotation_deg" value="$(arg image_rotation_deg)" />
    <param name="flip_horizontal" value="$(arg flip_horizontal)" />
    <param name="flip_vertical" value="$(arg flip_vertical)" />
    <param name="mock_valid_detection" value="false" />
  </node>

  <node pkg="human_follow_perception" type="tracker_node.py" name="human_follow_tracker" output="screen">
    <param name="min_consecutive_valid_inputs" value="$(arg min_consecutive_valid_inputs)" />
  </node>

  <node pkg="human_follow_fusion" type="target_fusion_node.py" name="human_follow_target_fusion" output="screen">
    <param name="enable_mock_projection" value="false" />
    <param name="pointcloud_topic" value="$(arg pointcloud_topic)" />
    <param name="intrinsics_yaml" value="$(arg intrinsics_yaml)" />
    <param name="extrinsics_yaml" value="$(arg extrinsics_yaml)" />
    <param name="output_topic" value="$(arg fusion_output_topic)" />
  </node>

  <node pkg="human_follow_fusion" type="target_frame_adapter_node.py" name="human_follow_target_frame_adapter" output="screen">
    <param name="input_topic" value="$(arg fusion_output_topic)" />
    <param name="output_topic" value="$(arg fusion_body_output_topic)" />
    <param name="transform_yaml" value="$(arg camera_body_yaml)" />
  </node>

  <node pkg="human_follow_bringup" type="target_world_projector_node.py" name="target_world_projector" output="screen">
    <param name="input_topic" value="$(arg fusion_body_output_topic)" />
    <param name="odom_topic" value="/follow/lio/odom" />
    <param name="output_topic" value="$(arg fusion_world_output_topic)" />
  </node>

  <include file="$(find human_follow_bringup)/launch/stage1_controller_slot.launch">
    <arg name="controller_provider" value="$(arg controller_provider)" />
    <arg name="controller_input_topic" value="$(arg fusion_body_output_topic)" />
    <arg name="controller_command_topic" value="/follow/control/cmd_body" />
    <arg name="controller_state_topic" value="/follow/state" />
    <arg name="controller_target_world_topic" value="$(arg fusion_world_output_topic)" />
    <arg name="controller_odom_topic" value="/follow/lio/odom" />
    <arg name="controller_pointcloud_topic" value="$(arg pointcloud_topic)" />
    <arg name="controller_require_pointcloud" value="true" />
    <arg name="controller_node_name" value="$(arg controller_node_name)" />
    <arg name="external_controller_pkg" value="$(arg external_controller_pkg)" />
    <arg name="external_controller_type" value="$(arg external_controller_type)" />
  </include>
</launch>
