<launch>
  <arg name="video_path" default="" />
  <arg name="image_topic" default="/follow/camera/image_raw" />
  <arg name="publish_rate_hz" default="12.0" />
  <arg name="detector_backend" default="hog" />
  <arg name="enable_overlay" default="true" />
  <arg name="max_duration_sec" default="18.0" />
  <arg name="monitor_required" default="true" />

  <include file="$(find human_follow_bringup)/launch/stage1_offline_video_px4.launch">
    <arg name="video_path" value="$(arg video_path)" />
    <arg name="image_topic" value="$(arg image_topic)" />
    <arg name="publish_rate_hz" value="$(arg publish_rate_hz)" />
    <arg name="detector_backend" value="$(arg detector_backend)" />
    <arg name="enable_overlay" value="$(arg enable_overlay)" />
  </include>

  <node pkg="human_follow_bringup" type="offline_video_smoke_monitor_node.py" name="offline_video_smoke_monitor" output="screen" required="$(arg monitor_required)">
    <param name="image_topic" value="$(arg image_topic)" />
    <param name="max_duration_sec" value="$(arg max_duration_sec)" />
  </node>
</launch>
