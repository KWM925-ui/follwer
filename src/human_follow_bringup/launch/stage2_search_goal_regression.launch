<launch>
  <arg name="max_duration_sec" default="12.0" />
  <arg name="monitor_required" default="true" />

  <node pkg="human_follow_bringup" type="stage2_goal_input_fixture_node.py" name="stage2_goal_input_fixture" output="screen">
    <param name="publish_rate_hz" value="15.0" />
    <param name="loop" value="true" />
    <param name="target_world_topic" value="/follow/fusion/target_world" />
    <param name="odom_topic" value="/follow/lio/odom" />
    <param name="cloud_topic" value="/follow/lidar/points" />
    <param name="phase_label_topic" value="/follow/test/phase_label" />
    <rosparam param="phases">
      - {label: target_ahead, duration_sec: 1.6, target_xyz: [6.0, 0.0, 1.7], odom_xyz: [1.0, 0.0, 1.2], odom_yaw_deg: 0.0}
      - {label: target_right_bias, duration_sec: 1.6, target_xyz: [6.2, -1.1, 1.7], odom_xyz: [1.4, 0.3, 1.2], odom_yaw_deg: 18.0}
      - {label: search_loss_right, duration_sec: 1.8, publish_target: false, odom_xyz: [1.4, 0.3, 1.2], odom_yaw_deg: 18.0, cloud_center_xyz: [2.3, 0.6, 1.2]}
    </rosparam>
  </node>

  <include file="$(find human_follow_bringup)/launch/stage2_goal_slot.launch">
    <arg name="goal_provider" value="baseline" />
    <arg name="target_world_topic" value="/follow/fusion/target_world" />
    <arg name="odom_topic" value="/follow/lio/odom" />
    <arg name="goal_topic" value="/follow/stage2/goal" />
    <arg name="debug_path_topic" value="/follow/stage2/debug_goal_path" />
    <arg name="follow_distance_m" value="3.5" />
    <arg name="search_timeout_sec" value="2.0" />
    <arg name="lost_timeout_sec" value="5.0" />
    <arg name="search_yaw_rate_rps" value="0.5" />
    <arg name="search_sweep_span_deg" value="120.0" />
    <arg name="search_sweep_pass_count" value="2" />
    <arg name="search_return_to_center" value="false" />
    <arg name="search_goal_radius_m" value="1.2" />
  </include>

  <node pkg="human_follow_bringup" type="stage2_search_goal_regression_monitor_node.py" name="stage2_search_goal_regression_monitor" output="screen" required="$(arg monitor_required)">
    <param name="goal_topic" value="/follow/stage2/goal" />
    <param name="phase_label_topic" value="/follow/test/phase_label" />
    <param name="required_search_phase" value="search_loss_right" />
    <param name="max_duration_sec" value="$(arg max_duration_sec)" />
    <param name="min_search_goal_shift_m" value="0.35" />
  </node>
</launch>
